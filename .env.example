# PermitBridge does not require any paid APIs or database credentials for
# the v1 static-JSON build. This file is kept as a placeholder for future
# optional integrations (e.g. analytics, an eventual database migration).

NEXT_PUBLIC_SITE_URL=https://www.getpermitbridge.com

# Optional. Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# When unset, the GoogleAnalytics component renders nothing — no script is
# loaded, no traffic data is sent. Set this only in Vercel's production
# environment variables, not in local/preview, so dev traffic never
# pollutes real analytics data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Google Tag Manager container ID (format: GTM-XXXXXXX).
# When unset, GoogleTagManagerHead/Body render nothing — no script is
# loaded. Set this only in Vercel's production environment variables,
# for the same reason as the GA4 var above.
NEXT_PUBLIC_GTM_ID=

# Required to authorize calls to /api/cron/source-monitor (a manual
# diagnostic endpoint only — GitHub Actions, not Vercel Cron, is the
# actual scheduled executor for the monitoring system since Phase 4.9,
# because Vercel's deployed Serverless Functions have a read-only
# filesystem). The endpoint fails CLOSED if this is unset — every request
# is rejected, not silently allowed. Generate a real random secret for
# production (e.g. `openssl rand -hex 32`) and set it in Vercel's project
# environment variables — never commit a real value here.
CRON_SECRET=
