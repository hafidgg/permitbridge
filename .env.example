# PermitBridge does not require any paid APIs or database credentials for
# the v1 static-JSON build. This file is kept as a placeholder for future
# optional integrations (e.g. analytics, an eventual database migration).

NEXT_PUBLIC_SITE_URL=https://www.getpermitbridge.com

# Required to authorize calls to /api/cron/source-monitor (Phase 4.8).
# The endpoint fails CLOSED if this is unset — every request is rejected,
# not silently allowed. Generate a real random secret for production
# (e.g. `openssl rand -hex 32`) and set it in Vercel's project environment
# variables — never commit a real value here.
#
# Vercel Cron (see vercel.json) automatically sends this same value as
# `Authorization: Bearer <CRON_SECRET>` when the env var is set on the
# project, so no extra configuration is needed beyond setting the
# variable itself in the Vercel dashboard.
CRON_SECRET=
