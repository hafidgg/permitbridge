# pipeline/monitoring runtime cache — ephemeral ETag/ConditionalGET cache
# written by lib/pipeline/fetcher.ts's fetchLive() (reused as-is by the
# monitoring engine, lib/monitoring/fetch.ts, since Phase 4.2). Never
# meant to be committed — only .gitkeep preserves the directory itself.
# Discovered the hard way: the first real (mode=live) GitHub Actions run
# of source-monitor.yml correctly REFUSED to commit this, since it fell
# outside the intended data/knowledge-base/monitoring/ path allowlist.
data/_pipeline/cache/*
!data/_pipeline/cache/.gitkeep
